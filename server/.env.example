# Copiar a server/.env y completar. server/.env NO se versiona (.gitignore).
# Todos los valores deben ser FICTICIOS / exclusivos del laboratorio.

# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# 1 = monta las rutas vulnerables /vuln/* (solo para demostraciones)
LAB_VULN=0

# --- Base de datos (MySQL local) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portal_app
DB_PASSWORD=__CAMBIAR__
DB_NAME=portal_lab

# --- Claves de aplicación (generar con: openssl rand -base64 32) ---
# Firma de tokens de sesión
SESSION_SECRET=__CAMBIAR__
# Cifrado de datos en reposo (AES-256-GCM). Debe decodificar a exactamente 32 bytes.
# Versionadas: DATA_KEY_V1, DATA_KEY_V2, ... ; DATA_KEY_CURRENT indica cuál cifra lo nuevo.
DATA_KEY_V1=__CAMBIAR__
DATA_KEY_CURRENT=v1
# Seudonimización HMAC de correos en logs
LOG_HMAC_KEY=__CAMBIAR__

# --- Contraseñas de las cuentas ficticias que crea el seed ---
SEED_ADMIN_PASSWORD=__CAMBIAR__
SEED_USER_PASSWORD=__CAMBIAR__
