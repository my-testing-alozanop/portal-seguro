{
  "name": "portal-lab-server",
  "version": "0.1.0",
  "private": true,
  "description": "API del portal universitario de laboratorio (MASI - Seguridad en Aplicaciones)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js && node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "jest": "^30.5.2",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
