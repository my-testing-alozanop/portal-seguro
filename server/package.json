{
  "name": "portal-lab-server",
  "version": "0.1.0",
  "private": true,
  "description": "API del portal universitario de laboratorio (MASI - Seguridad en Aplicaciones)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js && node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ]
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
